EXPO_PUBLIC_SUPABASE_URL=https://pvpnaxjaacoiyyuicjzp.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# supabase = write customers/jobs/etc to Postgres (default when anon key is set)
# local = AsyncStorage only
EXPO_PUBLIC_DATA_MODE=supabase

# Google sign-in
# 1) Enable Google under Supabase → Authentication → Providers (required for OAuth fallback)
# 2) Optional native IdToken path: also set WEB client ID from Google Cloud Console
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Redirect URL allowed in Supabase Auth URL config (use your web origin in dev)
EXPO_PUBLIC_AUTH_REDIRECT_URL=
